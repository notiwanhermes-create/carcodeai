// The one definition of the CarCode AI database.
//
// Tables are created and changed ONLY by the SQL migrations in
// prisma/migrations (applied with `npm run db:migrate`). Nothing in the running
// app creates or alters tables. `tests/integration` checks that this file and
// the migrations describe the same database.
//
// Table and column names are the ones the database has always used (`@@map` /
// `@map`), so adopting migrations renamed nothing.
//
// An existing database (production) also still holds a few things that older
// versions of the app created and nothing uses any more: see docs/database.md,
// "Left for a later clean-up". They are deliberately not described here, so
// the app cannot come to depend on them.
//
// Not expressible here, but created by the migrations and worth knowing:
//   users.users_email_lowercase              CHECK (email = lower(email))
//   garage_vehicles_model_year_check         CHECK (model_year between 1900 and 2100)
//   maintenance_records_odometer_check       CHECK (odometer_value >= 0, unit is 'km' or 'mi')
//   maintenance_records_cost_amount_check    CHECK (cost_amount >= 0)
//   garage_vehicles_odometer_check           CHECK (odometer_value >= 0, unit is 'km' or 'mi')
//   diagnoses_status_check                   CHECK (status in 'open', 'resolved', 'dismissed')
//   diagnoses_source_check                   CHECK (source in 'app', 'device_import')
//   diagnoses_odometer_check                 CHECK (odometer_value >= 0, unit is 'km' or 'mi')
//   confirmed_fixes_odometer_check           CHECK (odometer_value >= 0, unit is 'km' or 'mi')
//   confirmed_fixes_description_check        CHECK (description is not blank)
//   confirmed_fixes_outcome_check            CHECK (outcome is 'fixed' or 'did_not_hold')
//   confirmed_fixes_attempt_check            CHECK (attempt >= 1)
//   confirmed_fixes_returned_check           CHECK (returned_at is set exactly when outcome is 'did_not_hold')
//   guided_diagnostic_sessions_lifecycle_check      CHECK (lifecycle is 'active' or 'completed')
//   guided_diagnostic_sessions_revision_check       CHECK (revision >= 1)
//   guided_diagnostic_sessions_versions_check       CHECK (persistence_version >= 1 and session_format_version >= 1)
//   guided_diagnostic_sessions_completed_check      CHECK (completed_at is set exactly when lifecycle is 'completed')
//   guided_diagnostic_session_revisions_revision_check    CHECK (revision >= 1 and input_count >= 0)
//   guided_diagnostic_session_revisions_transition_check  CHECK (transition is 'start' or 'input')
//   guided_diagnostic_session_revisions_lifecycle_check   CHECK (lifecycle is 'active' or 'completed')
//   guided_diagnostic_session_revisions_origin_check      CHECK (input_origin is 'direct' or 'ai_parser')
//   guided_diagnostic_session_revisions_ai_ref_check      CHECK (ai_text_ref is set exactly when input_origin is 'ai_parser')

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An account. Signs in with a password, with Google, or both.
model User {
  id           String   @id @default(cuid())
  /// Always stored trimmed and in lower case (enforced by the database).
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  profileImage String?  @map("profile_image")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// When ownership of the email address was proven (our emailed link plus the
  /// account password, or a Google sign-in with a verified email).
  emailVerified    DateTime? @map("email_verified") @db.Timestamptz()
  /// Bumped to sign out every existing session for this user.
  sessionVersion   Int       @default(0) @map("session_version")
  /// True for password accounts created before email verification existed.
  /// They can still sign in, but are not trusted as proven email owners.
  legacyUnverified Boolean   @default(false) @map("legacy_unverified")

  vehicles           Vehicle[]
  maintenanceRecords MaintenanceRecord[]
  diagnoses          Diagnosis[]
  confirmedFixes     ConfirmedFix[]
  verificationTokens EmailVerificationToken[]
  /// Guided Diagnostics research (V2G). Nothing in the app reads or writes these yet.
  guidedDiagnosticSessions GuidedDiagnosticSession[]

  @@map("users")
}

/// Single-use tokens emailed to new password accounts. Only a SHA-256 hash is stored.
model EmailVerificationToken {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Deleting an account deletes its tokens.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// A vehicle in a signed-in user's garage.
model Vehicle {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// The year as the user entered it. Still the value the app shows.
  year      String
  /// The same year as a number. Empty when `year` is not a four-digit year.
  modelYear Int?     @map("model_year")
  make      String
  model     String
  engine    String?
  vin       String?
  nickname  String?
  /// Never read or written by the app, but the previous version still selects
  /// it, so it stays for now. Hidden from the client here; a later clean-up
  /// migration drops it once rolling back to that version is no longer needed.
  isActive  Boolean  @default(false) @map("is_active") @ignore
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Trim level, if the user entered one.
  trim              String?
  /// The latest odometer reading known for this vehicle, and when it was recorded.
  /// The unit is "km" or "mi" when known. A lower value is only ever stored when
  /// the user confirms it is a correction.
  odometerValue     Int?      @map("odometer_value")
  odometerUnit      String?   @map("odometer_unit")
  odometerUpdatedAt DateTime? @map("odometer_updated_at") @db.Timestamptz()
  /// Set when the user removes a vehicle that has history. The vehicle leaves
  /// the garage but nothing is deleted, and it can be restored.
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz()

  /// Deleting an account deletes its vehicles.
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  maintenanceRecords MaintenanceRecord[]
  diagnoses          Diagnosis[]
  confirmedFixes     ConfirmedFix[]
  /// Guided Diagnostics research (V2G). Nothing in the app reads or writes these yet.
  guidedDiagnosticSessions GuidedDiagnosticSession[]

  @@index([userId, createdAt])
  @@map("garage_vehicles")
}

/// One service entry for a vehicle.
///
/// `date`, `odometer` and `cost` hold exactly what the user typed. Next to each
/// is a typed copy, filled in only when the text converts cleanly, so nothing a
/// user entered is ever altered or lost by a conversion.
model MaintenanceRecord {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  vehicleId   String  @map("vehicle_id")
  serviceType String  @map("type")
  notes       String?

  date        String
  serviceDate DateTime? @map("service_date") @db.Date

  odometer      String? @map("mileage")
  odometerValue Int?    @map("odometer_value")
  /// "km" or "mi" when the user said which; otherwise empty.
  odometerUnit  String? @map("odometer_unit")

  cost       String?
  costAmount Decimal? @map("cost_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Deleting an account deletes its service records.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Deleting a vehicle deletes that vehicle's service records.
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicleId, createdAt])
  @@index([userId, createdAt])
  @@map("maintenance_records")
}

/// One saved diagnosis: what the user asked, for which vehicle, and what the AI
/// answered. It is a HYPOTHESIS. What actually fixed the problem, if the user
/// reports it, lives in ConfirmedFix and never changes this record.
///
/// The diagnosis belongs to the vehicle it was run for (`vehicleId`), and keeps
/// a snapshot of that vehicle as it was described at the time, so later edits
/// to the vehicle do not rewrite history.
model Diagnosis {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  vehicleId String @map("vehicle_id")

  /// "open", "resolved" or "dismissed".
  status          String    @default("open")
  statusChangedAt DateTime? @map("status_changed_at") @db.Timestamptz()
  /// When the user last answered "did this fix it?" without resolving it.
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz()

  /// "app": produced by this app for a signed-in user. "device_import": copied
  /// from history kept in the browser, which the server cannot vouch for.
  source   String @default("app")
  /// Language the answer was written in.
  language String @default("en")

  /// { year, make, model, engine, trim } as diagnosed.
  vehicleSnapshot Json   @map("vehicle_snapshot")
  /// The trouble codes exactly as the user typed them.
  codeInput       String @default("") @map("code_input")
  symptoms        String @default("")
  /// What is on file for each submitted code (trusted or not), for display.
  codes           Json   @default("[]")
  /// The structured diagnosis: summary, driving guidance, ranked causes with
  /// checks, limits and follow-up questions. No prompts or model internals.
  result          Json
  /// The follow-up answers the current result takes into account.
  followUps       Json   @default("[]") @map("follow_ups")
  /// How many times follow-up answers updated this diagnosis.
  updateCount     Int    @default(0) @map("update_count")

  /// Odometer reading given with the request, if any.
  odometerValue Int?    @map("odometer_value")
  odometerUnit  String? @map("odometer_unit")

  /// Id inside the signed follow-up ticket, so an update finds its diagnosis.
  ticketId  String? @map("ticket_id")
  /// Id the record had on the device it was imported from, so an import cannot
  /// create the same diagnosis twice.
  importKey String? @map("import_key")

  diagnosedAt DateTime @default(now()) @map("diagnosed_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  /// Deleting an account deletes its diagnoses.
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A vehicle that has diagnoses cannot be deleted from under them.
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: NoAction)
  /// Every repair the user reported for this problem, in the order reported.
  confirmedFixes ConfirmedFix[]

  @@unique([userId, ticketId])
  @@unique([userId, importKey])
  @@index([vehicleId, diagnosedAt])
  @@index([userId, status, diagnosedAt])
  @@map("diagnoses")
}

/// A repair the user reported for a diagnosed problem.
///
/// Kept apart from the diagnosis on purpose: the diagnosis is the AI's
/// hypothesis, this is what the user says happened. `matchedCause*` is filled
/// in only when the user says the repair was one of the causes the diagnosis
/// listed.
///
/// A diagnosis can collect several over time. Reopening a resolved diagnosis
/// does not delete its repair: the repair stays, marked "did_not_hold", and a
/// later repair is stored as the next attempt. A repair that did not hold is
/// never edited or removed afterwards (only deleting the vehicle for good, or
/// the account, removes it).
model ConfirmedFix {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  vehicleId   String @map("vehicle_id")
  diagnosisId String @map("diagnosis_id")

  /// 1 for the first repair reported for the diagnosis, 2 for the next, and so on.
  attempt    Int       @default(1)
  /// "fixed": the repair that currently stands as the resolution.
  /// "did_not_hold": the user later said the problem came back.
  outcome    String    @default("fixed")
  /// When the user said the problem came back.
  returnedAt DateTime? @map("returned_at") @db.Timestamptz()

  /// The repair in the user's own words.
  description       String
  matchedCauseRank  Int?    @map("matched_cause_rank")
  matchedCauseTitle String? @map("matched_cause_title")

  fixedOn       DateTime @map("fixed_on") @db.Date
  odometerValue Int?     @map("odometer_value")
  odometerUnit  String?  @map("odometer_unit")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: NoAction)
  /// A reported repair goes with its diagnosis.
  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  /// One row per attempt: a double submit cannot record the same repair twice.
  @@unique([diagnosisId, attempt])
  @@index([vehicleId, fixedOn])
  @@index([userId, createdAt])
  @@map("confirmed_fixes")
}

/// A persisted guided-diagnostic session (Guided Diagnostics V2G, research).
///
/// NOTHING IN THE APP READS OR WRITES THIS YET. Written only through
/// app/lib/diagnostic-workflow-persistence, which validates every row it reads:
/// the database is never the diagnostic authority. A stored session is used
/// only after the deterministic engine has replayed its inputs and arrived at
/// exactly the stored state.
///
/// The columns are for ownership, lookup, lifecycle and concurrency. The
/// session itself (pinned vehicle, pinned specifications, scans, evidence,
/// causes, conflict and verification) is `payload`, sealed by `payload_digest`.
/// The pinned vehicle in the payload is history: later edits to the garage
/// vehicle never rewrite it.
///
/// A COMPLETED session is history and is never updated. Every change to an
/// active one goes through compare-and-set on `revision` (no last-write-wins)
/// and appends one GuidedDiagnosticSessionRevision.
model GuidedDiagnosticSession {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  vehicleId String @map("vehicle_id")

  /// The exact workflow (id and version) and a fingerprint of its content.
  workflowId           String @map("workflow_id")
  workflowVersion      Int    @map("workflow_version")
  workflowFingerprint  String @map("workflow_fingerprint")
  /// Layout of this row (envelope) and of the stored session. Newer ones are refused, never guessed at.
  persistenceVersion   Int    @map("persistence_version")
  sessionFormatVersion Int    @map("session_format_version")

  /// 1 when started, plus one per accepted input. Updates name the revision they were based on.
  revision    Int
  /// "active" or "completed". Not the diagnostic outcome, which is in the payload.
  lifecycle   String  @default("active")
  /// The step waiting for input (null once completed). A copy for lookups; the payload decides.
  currentStep String? @map("current_step")

  /// The engine's session, in canonical plain-data form.
  payload            Json
  /// "sha256" or "hmac-sha256", and the digest over identity, versions, revision and payload.
  integrityAlgorithm String  @map("integrity_algorithm")
  payloadDigest      String  @map("payload_digest")
  /// The caller's key for an idempotent start: a retried start finds the session it already made.
  createKey          String? @map("create_key")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  /// Deleting an account deletes its sessions.
  user      User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Deleting a vehicle FOR GOOD (only possible once it is archived) deletes its
  /// sessions, as it deletes the rest of its history. Archiving deletes nothing.
  /// See docs/research/guided-diagnostics/v2g-persistence.md, "Vehicle relation".
  vehicle   Vehicle                           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  revisions GuidedDiagnosticSessionRevision[]

  @@unique([userId, createKey])
  @@index([userId, lifecycle, updatedAt])
  @@index([vehicleId, createdAt])
  @@map("guided_diagnostic_sessions")
}

/// One entry of a guided-diagnostic session's append-only history (V2G).
/// Never updated or deleted on its own. Metadata only: the session at any
/// revision is the replay of its first `inputCount` inputs. Rejected AI
/// proposals are never recorded, and AI-parsed text is referenced by hash only.
model GuidedDiagnosticSessionRevision {
  sessionId     String   @map("session_id")
  revision      Int
  /// "start" or "input".
  transition    String
  inputCount    Int      @map("input_count")
  /// The step the accepted input answered (null for the start).
  stepId        String?  @map("step_id")
  lifecycle     String
  currentStep   String?  @map("current_step")
  endResult     String?  @map("end_result")
  payloadDigest String   @map("payload_digest")
  /// "direct" or "ai_parser". The stored session is identical either way.
  inputOrigin   String   @default("direct") @map("input_origin")
  /// For an accepted AI-parsed input only: a hash of the user's text, never the text.
  aiTextRef     String?  @map("ai_text_ref")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// History goes with its session.
  session GuidedDiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, revision])
  @@map("guided_diagnostic_session_revisions")
}

/// Short-lived counters: request rate limits, daily allowances, and the number
/// of follow-up updates made on one diagnosis (see app/lib/rate-limit.ts).
///
/// A row is one counter for one window of time. `expiresAt` is when it stops
/// mattering; expired rows are deleted, so this table does not grow without limit.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz()
  count       Int      @default(0)
  expiresAt   DateTime @default(dbgenerated("(now() + '2 days'::interval)")) @map("expires_at") @db.Timestamptz()

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limits")
}

/// A message sent through the feedback form.
model Feedback {
  /// 64-bit, because that is what the production table has always had.
  id        BigInt   @id @default(autoincrement())
  name      String?
  email     String?
  rating    Int?
  message   String
  /// Origin and path of the page the feedback was sent from (no query string).
  pageUrl   String?  @map("page_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([createdAt])
  @@map("feedback")
}
