+const samePath = (a, b) => resolve(a).replace(/\\/g, "/").toLowerCase() === resolve(b).replace(/\\/g, "/").toLowerCase();
+
+/**
+ * Which CarCode workspace a checkout belongs to. Linked worktrees of one
+ * repository share a Git common directory, so `canonical` is the same for all
+ * of them; an independent clone has its own.
+ */
+export async function workspaceIdentity(repo) {
+  const r = await git(repo, ["rev-parse", "--path-format=absolute", "--git-dir", "--git-common-dir"]);
+  const [gitDir, commonDir] = r.stdout.trim().split("\n").map((l) => resolve(l.trim()));
+  const linked = !samePath(gitDir, commonDir);
+  const canonical = basename(commonDir) === ".git" ? dirname(commonDir) : commonDir;
+  const branch = (await git(repo, ["branch", "--show-current"])).stdout.trim();
+  return { canonical, worktree: resolve(repo), linked, branch, commonDir };
+}
+
+/**
+ * Refuses a checkout that is not the canonical CarCode repository or one of its
+ * linked worktrees, when CARCODE_CANONICAL_REPO names the canonical checkout.
+ */
+export async function requireCanonicalWorkspace(workspace, env = process.env) {
+  const want = env.CARCODE_CANONICAL_REPO?.trim();
+  if (!want) return { enforced: false };
+  let expected;
+  try {
+    expected = await workspaceIdentity(want);
+  } catch {
+    throw new Error(`CARCODE_CANONICAL_REPO (${want}) is not a Git checkout.`);
+  }
+  if (!samePath(expected.commonDir, workspace.commonDir)) {
+    throw new Error(
+      `${workspace.worktree} is not the canonical CarCode workspace (${expected.canonical}) or one of its linked worktrees. ` +
+        "It is a separate copy; the manager will not treat it as CarCode. Run it from the canonical repository or a linked worktree of it.",
+    );
+  }
+  return { enforced: true };
+}
+
+/** One line naming the canonical repository and the worktree in use. */
+export function describeWorkspace(w) {
+  return w.linked
+    ? `Workspace: linked worktree ${w.worktree} (branch ${w.branch || "detached"}) of canonical CarCode repository ${w.canonical}.`
+    : `Workspace: canonical CarCode repository ${w.canonical} (branch ${w.branch || "detached"}).`;
+}
+
 export async function snapshot(repo) {
   const branch = (await git(repo, ["branch", "--show-current"])).stdout.trim();
   const head = (await git(repo, ["rev-parse", "HEAD"])).stdout.trim();
