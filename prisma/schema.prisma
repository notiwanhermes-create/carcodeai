generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  profileImage String?  @map("profile_image")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// When ownership of the email address was proven (our emailed link plus the
  /// account password, or a Google sign-in with a verified email).
  emailVerified    DateTime? @map("email_verified") @db.Timestamptz()
  /// Bumped to sign out every existing session for this user.
  sessionVersion   Int       @default(0) @map("session_version")
  /// True for password accounts created before email verification existed.
  /// They can still sign in, but are not trusted as proven email owners.
  legacyUnverified Boolean   @default(false) @map("legacy_unverified")

  sessions           Session[]
  vehicles           Vehicle[]
  maintenanceRecords MaintenanceRecord[]
  verificationTokens EmailVerificationToken[]

  @@map("users")
}

/// Single-use tokens emailed to new password accounts. Only a SHA-256 hash is stored.
model EmailVerificationToken {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Session {
  sid       String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Vehicle {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  year      String
  make      String
  model     String
  engine    String?
  vin       String?
  nickname  String?
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenanceRecords MaintenanceRecord[]

  @@map("garage_vehicles")
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  vehicleId   String   @map("vehicle_id")
  serviceType String   @map("type")
  date        String
  odometer    String?  @map("mileage")
  notes       String?
  cost        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("maintenance_records")
}

/// Fixed-window request counters used by app/lib/rate-limit.ts.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz()
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limits")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  rating    Int?
  message   String
  page      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("feedback")
}
