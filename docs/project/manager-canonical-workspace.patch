@@ -0,0 +1,69 @@
+// One canonical CarCode workspace: linked worktrees are identified as part of it,
+// independent copies are refused when CARCODE_CANONICAL_REPO is set.
+
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { existsSync, realpathSync } from "node:fs";
+import { join } from "node:path";
+import { test } from "node:test";
+import { buildClaudePrompt } from "../claude-adapter.mjs";
+import { runManager } from "../manager.mjs";
+import { describeWorkspace, workspaceIdentity } from "../repo.mjs";
+import { gitSync, makeRepo, quietLog } from "./helpers.mjs";
+
+const real = (p) => realpathSync(p);
+
+test("a linked worktree is identified as part of the canonical repository", async () => {
+  const fx = makeRepo();
+  try {
+    const wt = join(fx.root, "carcode-v2i");
+    gitSync(fx.repo, "worktree", "add", "-q", "-b", "research/v2i", wt);
+    const main = await workspaceIdentity(fx.repo);
+    const linked = await workspaceIdentity(wt);
+    assert.equal(main.linked, false);
+    assert.equal(linked.linked, true);
+    assert.equal(real(linked.canonical), real(fx.repo));
+    assert.equal(linked.branch, "research/v2i");
+    assert.match(describeWorkspace(linked), /linked worktree .*carcode-v2i \(branch research\/v2i\) of canonical CarCode repository/);
+
+    const env = { ...fx.env, CARCODE_CANONICAL_REPO: fx.repo };
+    const r = await runManager({ repo: wt, mode: "status" }, { env, log: quietLog });
+    assert.equal(r.exitCode, 0);
+    assert.equal(r.status.workspace.linked, true);
+    assert.equal(r.status.workspace.canonicalEnforced, true);
+    assert.equal(real(r.status.workspace.canonical), real(fx.repo));
+  } finally {
+    fx.cleanup();
+  }
+});
+
+test("an independent copy is refused when CARCODE_CANONICAL_REPO is set, and nothing is written", async () => {
+  const fx = makeRepo();
+  try {
+    const copy = join(fx.root, "carcode-ai-copy");
+    execFileSync("git", ["clone", "-q", fx.repo, copy]);
+    const env = { ...fx.env, CARCODE_CANONICAL_REPO: fx.repo };
+    for (const mode of ["status", "dry-run", "once"]) {
+      await assert.rejects(runManager({ repo: copy, goal: "g", mode }, { env, log: quietLog }), /is not the canonical CarCode workspace/);
+    }
+    assert.equal(existsSync(fx.stateDir), false);
+
+    await assert.rejects(runManager({ repo: fx.repo, mode: "status" }, { env: { ...fx.env, CARCODE_CANONICAL_REPO: join(fx.root, "missing") }, log: quietLog }), /is not a Git checkout/);
+    // Unset: allowed, as before.
+    assert.equal((await runManager({ repo: copy, mode: "status" }, { env: fx.env, log: quietLog })).exitCode, 0);
+  } finally {
+    fx.cleanup();
+  }
+});
+
+test("the Claude prompt names the linked worktree used for the task", () => {
+  const prompt = buildClaudePrompt({
+    taskId: "t-1",
+    mode: "implement",
+    task: "Do it",
+    branch: "research/v2i",
+    workspace: { canonical: "C:/carcode-ai", worktree: "C:/carcode-ai-worktrees/v2i", linked: true, branch: "research/v2i" },
+  });
+  assert.match(prompt, /C:\/carcode-ai-worktrees\/v2i\) is a linked worktree of the canonical CarCode repository C:\/carcode-ai/);
+  assert.doesNotMatch(buildClaudePrompt({ taskId: "t-1", mode: "implement", task: "x", branch: "b" }), /linked worktree/);
+});
