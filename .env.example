# CarCode AI — environment variables
#
# Copy this file to .env.local for local development and fill in the values.
# In production, set the same names in the hosting dashboard (Vercel -> Settings
# -> Environment Variables). Never commit real values.

# ── Required ─────────────────────────────────────────────────────────────────

# OpenAI key used by /api/diagnose.
OPENAI_API_KEY=

# PostgreSQL connection string (accounts, garage, maintenance, rate limits).
# On serverless hosting use the provider's POOLED connection string.
DATABASE_URL=

# Session encryption secret. Generate one with: npx auth secret
AUTH_SECRET=

# The exact address people open the site at, no trailing slash.
# Local: http://localhost:5000   Production: https://www.your-domain.com
# Also used to build the links in confirmation emails.
NEXTAUTH_URL=http://localhost:5000

# ── Google sign-in (optional; the button is hidden when not set) ─────────────
# Authorised redirect URI to register with Google:
#   <NEXTAUTH_URL>/api/auth/callback/google
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET and GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# are accepted as alternative names.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION for email/password sign-up: new accounts must confirm
# their email before they can sign in. Without these, password sign-up is
# refused with a clear message (Google sign-in keeps working). In local
# development the confirmation link is printed to the server log instead.
RESEND_API_KEY=
# Sender for confirmation emails, on a domain verified in Resend,
# e.g. "CarCode AI <no-reply@your-domain.com>". Falls back to FEEDBACK_FROM.
AUTH_EMAIL_FROM=

# Feedback widget: where notifications go, and the sender address.
FEEDBACK_TO=
FEEDBACK_FROM=
# FEEDBACK_REPLY_SUBJECT=We got your feedback — CarCode AI

# ── Admin ────────────────────────────────────────────────────────────────────
# Token for /admin/feedback. Use a long random value.
ADMIN_TOKEN=

# ── Abuse limits (all optional; the defaults are shown; 0 disables a limit) ──

# /api/diagnose
# DIAGNOSE_IP_BURST_LIMIT=20              # any requests per IP per window (floods)
# DIAGNOSE_IP_BURST_WINDOW_SECONDS=600
# DIAGNOSE_GUEST_DAILY_LIMIT=20           # AI diagnoses per day per IP when not signed in
# DIAGNOSE_USER_HOURLY_LIMIT=30           # AI diagnoses per signed-in user
# DIAGNOSE_USER_DAILY_LIMIT=100
# DIAGNOSE_GLOBAL_DAILY_LIMIT=0           # safety cap across everyone (off by default)
# DIAGNOSE_MAX_BODY_BYTES=16384

# /api/feedback
# FEEDBACK_IP_HOURLY_LIMIT=5
# FEEDBACK_IP_DAILY_LIMIT=20
# FEEDBACK_REPLY_DAILY_LIMIT=2            # confirmation emails per signed-in user per day

# Sign-in / sign-up
# AUTH_LOGIN_IP_LIMIT=30                  # sign-in attempts per IP per window
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_REGISTER_IP_HOURLY_LIMIT=10        # sign-ups (and resend requests) per IP per hour
# AUTH_VERIFY_EMAIL_HOURLY_LIMIT=3        # confirmation emails per address per hour

# Salt for hashing IP addresses in rate-limit keys (defaults to AUTH_SECRET).
# RATE_LIMIT_SALT=

# Only if the site sits behind another proxy that hides visitor IPs (for
# example Cloudflare in front of Vercel): the header carrying the real IP.
# TRUSTED_IP_HEADER=cf-connecting-ip
